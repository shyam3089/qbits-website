class Setting:
    id = ""
    label = ""
    value = ""

class ThemeToken:
    id = ""
    value = ""

component Admin:
    authenticated = false
    checking = true
    password = ""
    message = ""
    settings = [] as Setting
    tokens = [] as ThemeToken
    theme = "apple"
    div class="admin-panel":
        div class="admin-heading":
            div:
                p class="eyebrow" text="YOUR SITE, YOUR WAY"
                h1 class="content-title" text="Site settings"

            if authenticated:
                button class="small-button admin-logout" text="Sign out"

        if checking:
            p class="loading-state" text="Checking your session…"
        else:
            if not authenticated:
                p class="content-intro" text="Sign in to manage your Qbits website."

                div class="login-form":
                    label class="field-label" text="Admin password":
                        input class="password-input":
                            value=password
                            on input:
                                password = event.value

                    button class="small-button primary admin-login" text="Sign in"
            else:
                p class="content-intro" text="Changes are saved to this server and shared with every visitor."

                h2 class="admin-section-heading" text="Content & links"

                div class="settings-grid":
                    for setting in settings key=setting.id:
                        label class="field-label":
                            span text=setting.label

                            input class="setting-input":
                                value=setting.value
                                on input:
                                    setting.value = event.value

                h2 class="admin-section-heading" text="Theme"
                
                p class="admin-help" text="Choose a foundation, then customise its tokens below. Preview changes before saving."

                div class="theme-options":
                    button class="small-button theme-neon" text="Neon"
                    button class="small-button theme-ultraviolet" text="Ultraviolet"
                    button class="small-button theme-midnight" text="Midnight"
                    button class="small-button theme-apple" text="Apple Light"

                p class="current-theme" text="Selected: " + theme

                div class="token-toolbar":
                    h3 text="Theme tokens"
                    button class="text-button reset-tokens" text="Reset overrides"
                    
                p class="admin-help" text="All layout and appearance values are configurable. Use CSS values such as #f05be9, 46px or 1.2s. Breakpoint tokens are configured in themes/tokens.css at build time."

                div class="settings-grid token-grid":
                    for token in tokens key=token.id:
                        label class="field-label token-field":
                            span class="token-key" text=token.id

                            input class="token-input":
                                value=token.value
                                on input:
                                    token.value = event.value

                div class="admin-actions":
                    button class="small-button primary admin-save" text="Save changes"

                    button class="small-button admin-preview" text="Preview theme"

                    button class="text-button admin-discard" text="Discard unsaved changes"
                    
        p class="admin-message" text=message
