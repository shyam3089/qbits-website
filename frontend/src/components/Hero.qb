import ActionButton from "./ActionButton.qb"

component Hero(eyebrow = "", headline = "", highlight = "", description = "", second = ""):
    section class="hero":
        div class="hero-layout":
            div class="hero-copy":
                div class="hero-eyebrow":
                    span text=eyebrow
                    span class="eyebrow-line"

                h1 class="headline":
                    span text=headline + " "
                    span class="headline-highlight" text=highlight

                p class="hero-description":
                    span text=description
                    span text=second

            div class="hero-actions":
                ActionButton class="button-docs" label="Documentation"
                ActionButton class="button-install" label="Install qbits"

            div class="hero-art":
                span class="hero-art-logo"

            div class="hero-features":
                div class="hero-feature":
                    span class="icon hero-feature-icon feature-code"

                    div class="hero-feature-copy":
                        span class="hero-feature-title" text="Simple Syntax"
                        span text="Clean and intuitive"

                div class="hero-feature":
                    span class="icon hero-feature-icon feature-bolt"

                    div class="hero-feature-copy":
                        span class="hero-feature-title" text="Reactive UI"
                        span text="Fast and efficient"

                div class="hero-feature":
                    span class="icon hero-feature-icon feature-shield"

                    div class="hero-feature-copy":
                        span class="hero-feature-title" text="Modern & Secure"
                        span text="Built for real-world apps"
